{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malm.dev/schemas/cli/v1/envelope.schema.json",
  "title": "Malm human CLI JSON envelope v1",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "command": {
      "type": "string",
      "pattern": "^[a-z]+(?:[.-][a-z]+)*(?:\\.[a-z]+(?:[.-][a-z]+)*)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning", "notice"] },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "message": { "type": "string", "maxLength": 8192 }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command", "outcome", "data", "diagnostics"],
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "$ref": "#/$defs/command" },
        "outcome": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": { "const": "error" },
          "maxLength": 64
        },
        "data": { "type": "object" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" },
          "maxItems": 256
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command", "outcome", "data", "diagnostics", "error"],
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "$ref": "#/$defs/command" },
        "outcome": { "const": "error" },
        "data": { "type": "null" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" },
          "maxItems": 256
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "code", "message", "help"],
          "properties": {
            "category": {
              "enum": [
                "invalid_request",
                "unsupported",
                "not_found",
                "permission_denied",
                "conflict",
                "resource_limit",
                "unavailable",
                "internal"
              ]
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 64
            },
            "message": { "type": "string", "maxLength": 8192 },
            "help": { "type": ["string", "null"], "maxLength": 8192 }
          }
        }
      }
    }
  }
}
