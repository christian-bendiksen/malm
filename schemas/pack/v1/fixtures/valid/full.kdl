pack package-id="com.example.desktop" schema-version=1 {
    components {
        component "settings-formatter" interface="format-component/v1" digest="sha256-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" path="components/settings.wasm"
    }
    assets {
        asset "assets/logo.svg"
    }
    schemas {
        schema "schemas/settings.schema.json"
    }
    templates {
        template "templates/settings.toml"
    }
    dependencies {
        dependency "theme" package-id="org.example.theme" {
            git subdir="." commit="sha1-0123456789abcdef0123456789abcdef01234567" url="https://example.org/theme.git"
        }
        dependency "common" package-id="com.example.common" {
            local workspace-path="packs/common"
        }
    }
    modules {
        module "terminal" path="modules/terminal.kdl"
    }
    config-documents {
        document "config/desktop.kdl"
    }
}
